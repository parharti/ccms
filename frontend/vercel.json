{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "build": {
    "env": {
      "VITE_API_BASE_URL": "/api"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://ccms-8fkb.onrender.com/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
